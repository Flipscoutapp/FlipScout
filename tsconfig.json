{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "es2017"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
  "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistendCasingInFileNames": true,
    "noFallbackThroughInCase": true,
    "module": "es2020",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jpx": "react-jsx"
  },
  "include": [
    "src"
  ]
}
